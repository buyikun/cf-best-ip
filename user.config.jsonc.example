/* ============================================================================
 *  CF 优选 IP —— 配置文件【模板】
 * ----------------------------------------------------------------------------
 *  第一步：把这个文件改名为 user.config.jsonc（就是删掉末尾的 .example）
 *
 *     在资源管理器里点「查看」→ 勾选「文件扩展名」，
 *     然后右键改名，确保完整文件名是：
 *         user.config.jsonc
 *     而不是：
 *         user.config.jsonc.example   ← 没改成功
 *         user.config.jsonc.txt       ← 改错了（Windows 自动补了 .txt）
 *
 *  第二步：用记事本打开它，填下面第一节的三样东西
 *  第三步：双击 run-fast.cmd
 *
 *  ★ 不填也能跑 ★
 *    只要 apiToken / zoneId / records 任意一项为空，程序就进入"只测速"模式：
 *    只打印测速结果，绝不调用 Cloudflare 写接口，不会碰你的 DNS。
 *    可以先不改名、直接双击 run-fast.cmd 看看效果。
 * ========================================================================== */
{
  /* ────────────────────────────────────────────────────────────────
   *  一、Cloudflare 上传配置
   * ──────────────────────────────────────────────────────────────── */
  "cloudflare": {
    /* API Token：dash.cloudflare.com → 右上角头像 → My Profile → API Tokens
     *   → Create Token，权限选 Zone → DNS → Edit，
     *   并限定到你要用的那个域名（最小权限，最安全）。
     *   形如：cfut_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx */
    "apiToken": "",

    /* Zone ID：dash.cloudflare.com 点进该域名 → 右下角 Overview 面板里的
     *   Zone ID（32 位十六进制，注意不是 Account ID） */
    "zoneId": "",

    /* ────────────────────────────────────────────────────────────
     *  要自动替换的域名：一行一个，用英文双引号包起来，逗号分隔
     *
     *  就是这样，非常简单：
     *      "domains": [
     *        "mysite.你的域名.com"
     *      ]
     *
     *  只想换一个域名？就把下面这行改成你自己的，其余都不用动。
     *  需要多个域名？照着格式加行，注意上一行末尾要有逗号：
     *      "domains": [
     *        "a.你的域名.com",
     *        "b.你的域名.com"
     *      ]
     *
     *  注意：
     *    · 不要带 http:// 或结尾斜杠
     *    · 必须是这个 zoneId 所属域名下面的子域名
     * ──────────────────────────────────────────────────────────── */
    "domains": [
      "sub1.example.com"
    ],

    /* 下面是所有域名的通用设置，一般不用改。
     * 想给某个域名单独设置（比如不同的 topN），往下翻到「六、进阶：逐条定制域名」看示例。 */
    "defaults": {
      "type": "A",          /* 一般固定 "A"（IPv4） */
      "ttl": 300,           /* 缓存秒数，300=5 分钟；填 1 表示 CF 的 Auto */
      "proxied": false,     /* 是否开 CF 小云朵。优选 IP 必须 false */
      "topN": 3             /* 每个域名保留几个 IP（快速模式还会受 uploadCount 限制） */
    }
  },

  /* ────────────────────────────────────────────────────────────────
   *  二、IP 来源（默认 4 路订阅合并去重；也可换成你自己的订阅地址）
   * ──────────────────────────────────────────────────────────────── */
  "source": {
    "urls": [
      "https://raw.githubusercontent.com/HandsomeMJZ/cfip/refs/heads/main/full_ips.txt",
      "https://cf.junzhen.qzz.io/full_ips.txt",
      "https://cf.junzhen.qzz.io/full_ips_bj.txt",
      "https://cdn.jsdelivr.net/gh/HandsomeMJZ/cfip@main/full_ips.txt"
    ],
    "merge": true,            /* true=合并所有源；false=只用第一个能拉到的 */
    "preferUrl": true,        /* true=优先线上订阅，全失败才用本地缓存 */
    "cacheFile": "cache/full_ips.txt",
    "file": ""                /* 本地兜底文件路径，留空即可 */
  },

  /* ────────────────────────────────────────────────────────────────
   *  三、快速模式（run-fast.cmd，日常用这个）
   * ──────────────────────────────────────────────────────────────── */
  "fast": {
    /* ★「IP 可用」阈值(Mbps)：8 足够流畅看 1080p。
     *   调高更挑但更换更频繁；填 0 则按你本地带宽自动校准。 */
    "targetMbps": 8,
    "targetRatio": 0.6667,    /* 自动模式：本地带宽 × 该比例 */
    "targetMaxMbps": 20,      /* 自动模式的封顶值 */
    "targetTtlDays": 30,      /* 校准值多少天后重测 */

    /* 先体检 DNS 里正在用的 IP，达标就不折腾（多数情况几秒收工） */
    "healthCheck": true,
    "healthRounds": 2,        /* 每个 IP 测几次取最好；单次测速噪声很大，别改成 1 */

    /* 凑够 targetCount 个达标节点、且至少测满 minProbe 个就停止探测 */
    "targetCount": 10,
    "minProbe": 60,
    "uploadCount": 3,         /* 最终写入几个 IP */
    "maxProbe": 80,
    "maxSeconds": 300,

    /* 探测参数 —— 并发务必保持 1：
     * 并发测速会互抢带宽，实测能把 77Mbps 压成 8Mbps，排名完全失真 */
    "probeConcurrency": 1,
    "probeBytes": 1048576,
    "probeTimeoutMs": 2500,

    /* 本次比上次差太多就跳过写入，避免网络变差时越换越差 */
    "qualityGuard": true,
    "guardRatio": 0.5,

    "historyFile": "cache/history.json",
    "historyTtlHours": 12
  },

  /* ────────────────────────────────────────────────────────────────
   *  四、全量模式（run-full.cmd，想挖最快节点时用，慢但更全面）
   * ──────────────────────────────────────────────────────────────── */
  "probe": {
    "port": 443,              /* DNS 只能存 IP 不能存端口，统一用 443 实测 */
    "bytes": 1048576,
    "candidates": 150,        /* 粗筛节点数，调大更全面但更慢 */
    "rounds": 3,              /* 正式测速轮数，取中位数 */
    "tcpPool": 0,
    "tcpConcurrency": 40,
    "tcpTimeoutMs": 1500,
    "screenBytes": 262144,
    "screenConcurrency": 5,
    "screenTimeoutMs": 2500,
    "downloadTimeoutMs": 6000,
    "minMedianMbps": 1.0,     /* 中位速度低于此值淘汰 */
    "minOkRate": 0.5          /* 成功率低于此值淘汰 */
  },

  /* ────────────────────────────────────────────────────────────────
   *  五、运行行为
   * ──────────────────────────────────────────────────────────────── */
  "behavior": {
    "dryRun": false,          /* true = 全局只测速不上传 */
    "skipIfUnchanged": true,  /* 目标与现状一致时跳过写入 */
    "backupBeforeWrite": true,/* 写入前备份整份 DNS 记录 */
    "verifyDoh": true,        /* 写后用公共 DoH 复查解析 */
    "keepBackups": 3,         /* backups\ 只留最近几份 */
    "keepLogs": 3,            /* logs\ 只留最近几次 */
    "globalTimeoutMinutes": 15,
    "verbose": false
  }
}

/* ============================================================================
 *  六、进阶：逐条定制域名（可选，看不懂就完全不用管这一节）
 * ----------------------------------------------------------------------------
 *  上面的 "domains" 写法会让所有域名都用 "defaults" 里的同一套设置。
 *  如果你想让某个域名有不同设置（比如主域名留 5 个 IP、次要的只留 2 个，
 *  或者给某个域名单独排除日本节点），把 "domains" 换成 "records" 即可。
 *
 *  写法示例（把上面 cloudflare 里的 "domains" 整段删掉，换成下面这段）：
 *
 *      "records": [
 *        {
 *          "name": "main.你的域名.com",
 *          "topN": 5,
 *          "filter": { "mode": "deny", "tokens": ["JP"] }
 *        },
 *        {
 *          "name": "img.你的域名.com",
 *          "topN": 2,
 *          "proxied": false,
 *          "filter": { "mode": "allow", "tokens": ["HK", "SG"] }
 *        }
 *      ]
 *
 *  说明：
 *    · 每条只需写 "name"，其余项不写就自动套用 "defaults" 的值
 *    · "filter" 按国家码筛选节点：
 *         mode="deny"  → 排除 tokens 里的国家
 *         mode="allow" → 只保留 tokens 里的国家
 *         tokens=[]    → 不筛选（全部可用）
 *      国家码就是订阅文件里 # 后面那两位：JP=日本 HK=香港 US=美国 SG=新加坡 …
 *
 *  "domains" 和 "records" 也可以同时写（一般没必要）：
 *    · records 里出现的域名，用 records 的个性化设置
 *    · domains 里额外出现的域名，用 defaults 的通用设置
 *
 *  一句话总结：只想换掉域名 → 改 "domains" 就够了，这一节不用看。
 * ========================================================================== */

/* ============================================================================
 *  七、国家码是什么？（filter 里的 "JP" / "HK" 这些）
 * ----------------------------------------------------------------------------
 *  订阅文件下载下来长这样，一行一个节点：
 *
 *      95.174.68.155:2083#AE [3M]        ← 阿联酋，标称 3Mbps
 *      20.174.15.226:443#AE [3M]         ← IPv4:端口#国家码 [标称速度]
 *      91.132.93.153:443#AE [6M]
 *      147.78.0.186:8443#AE [0M]
 *      162.159.61.183:443#JP [7M]        ← 日本
 *      43.160.203.174:443#SG [13M]       ← 新加坡
 *
 *  其中 # 后面那两位（AE / JP / SG）就是**国家/地区码**，
 *  由订阅源本身标注，表示这个节点出口位于哪个国家。
 *
 *  这些码就是 ISO 3166-1 alpha-2 标准的两字母缩写，常见的有：
 *
 *      JP=日本  HK=香港  SG=新加坡  KR=韩国  TW=台湾  MO=澳门
 *      US=美国  CA=加拿大  GB=英国  DE=德国  FR=法国  NL=荷兰
 *      RU=俄罗斯  AU=澳大利亚  IN=印度  MY=马来西亚  TH=泰国  VN=越南
 *
 *  当前订阅源里实际出现过 76 个国家码，完整列表：
 *      AE AL AM AR AT AU AZ BE BG BH BR BY CA CH CL CN CU CY CZ DE DK
 *      DO EC EE EG ES FI FR GB GE GR HK HR HU ID IE IL IN IR IS IT JP
 *      KG KH KR KZ LT LV MD MK MO MX MY NG NL NO NZ OM PL PT RO RS RU
 *      SA SE SG SI SK TH TR TW UA US UZ VN ZA
 *
 *  查不到某个码是什么意思？搜 "ISO 3166 country code XX" 即可。
 *
 *  ── 怎么用 ──────────────────────────────────────────────────
 *
 *      "filter": { "mode": "deny", "tokens": ["JP"] }
 *          → 排除日本的节点（其他国家的都能用）
 *
 *      "filter": { "mode": "allow", "tokens": ["HK", "SG", "JP"] }
 *          → 只用香港、新加坡、日本的节点
 *
 *      "filter": { "mode": "deny", "tokens": [] }
 *          → 不筛选，所有国家的节点都参与测速
 *
 *  提示：不写 filter 或 tokens 为空，效果是一样的——都不筛选。
 *  多数情况下你不需要设置它，让程序自己测速挑最快的就行。
 *
 *  ⚠ 注意：麒麟优选（HTML 表格源）没有国家码，它的那一列放的是
 *    运营商分组，程序会转成下面这 4 个代号：
 *        TEL = 电信    UNI = 联通    CMB = 移动    MUL = 多线
 *    所以 filter 里写 TEL/UNI/CMB/MUL 可以按运营商筛选，
 *    但写 JP 这类国家码是匹配不到该源节点的（会被筛掉）。
 *
 *    想只保留所有源里的节点、不做任何国家筛选 → 用 tokens: []
 * ========================================================================== */
