{
  "_说明": "程序内置默认参数。你要改的变量请写在 user.config.jsonc（用户变量文件）里。本文件的 cloudflare 段只是占位，填什么都不会被使用。",

  "cloudflare": {
    "_说明": "占位：Cloudflare 上传凭据【只认 user.config.jsonc】。这里留空是刻意的。",
    "apiToken": "",
    "zoneId": "",
    "records": []
  },

  "source": {
    "_说明": "多源合并去重。tier=fresh 表示高频更新的源（优先测），tier=legacy 表示更新慢的旧源（垫后测）。",
    "urls": [
      { "url": "https://raw.githubusercontent.com/free-nodes/bestcf/main/xinyitang3/ipv4.txt", "tier": "fresh", "name": "Mia优选(港/新/韩/日/美)" },
      { "url": "https://raw.githubusercontent.com/free-nodes/bestcf/main/tiancheng/all.txt", "tier": "fresh", "name": "天诚优选1(港/新/韩/日/美/台/德)" },
      { "url": "https://api.uouin.com/cloudflare.html", "tier": "fresh", "name": "麒麟优选(HTML,运营商分组)" },
      { "url": "https://cf.junzhen.qzz.io/full_ips_bj.txt", "tier": "fresh", "name": "junzhen北京电信" }
    ],
    "merge": true,
    "preferUrl": true,
    "cacheFile": "var/cache/full_ips.txt",
    "file": "",
    "maxAgeMinutes": 0
  },

  "probe": {
    "port": 443,
    "candidates": 0,
    "verifyTopN": 15,
    "verifyRounds": 2,
    "probeDurationSec": 1.5,
    "verifyDurationSec": 3.0,
    "verifyWarmSec": 0.8,
    "screenBytes": 16384,
    "screenConcurrency": 32,
    "screenTimeoutMs": 2500,
    "minMedianMbps": 1.0,
    "minOkRate": 0.5
  },

  "fast": {
    "_说明": "快速模式默认参数。常用项都在 user.config.jsonc 里有一份带注释的副本。",
    "localBandwidthMbps": 0,
    "targetMbps": 8,
    "targetRatio": 0.6667,
    "targetMaxMbps": 20,
    "targetTtlDays": 30,
    "floorMbps": 2,
    "fallbackAfterProbes": 30,
    "healthCheck": true,
    "healthRounds": 2,
    "targetCount": 10,
    "minProbe": 60,
    "uploadCount": 3,
    "maxProbe": 80,
    "screenBytes": 16384,
    "screenConcurrency": 32,
    "screenTimeoutMs": 2500,
    "probeConcurrency": 1,
    "probeDurationSec": 1.5,
    "preselectRatio": 0.4,
    "healthDurationSec": 2.5,
    "healthWarmSec": 0.8,
    "verifyDurationSec": 3.0,
    "verifyWarmSec": 0.8,
    "verifyRounds": 2,
    "qualityGuard": true,
    "guardRatio": 0.5,
    "maxSeconds": 300,
    "bandwidthCacheFile": "var/cache/bandwidth.json",
    "bandwidthCacheHours": 24,
    "bandwidthSeconds": 4,
    "historyFile": "var/cache/history.json",
    "historyTtlHours": 12
  },

  "behavior": {
    "dryRun": false,
    "skipIfUnchanged": true,
    "backupBeforeWrite": true,
    "verifyDoh": true,
    "logDir": "var/logs",
    "backupDir": "var/backups",
    "keepBackups": 3,
    "keepLogs": 3,
    "stateFile": "var/state.json",
    "globalTimeoutMinutes": 60
  }
}
